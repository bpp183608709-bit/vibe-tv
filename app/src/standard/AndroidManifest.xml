<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="app.orchard.tv.MainActivity">
            <!-- The maker's own launcher declares priority 100 for this filter, and the package
                 manager settles a tie on priority alone: at 0 Aerial never won, so every Home press
                 landed on PatchWall and the guard had to take it back seconds later. Above 100
                 Aerial is resolved as Home on firmwares that leave the choice to the package
                 manager; those that hard-wire the launcher (this MiTV, Android 9) ignore it. -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Coocaa's private Home category, which its firmware picks the launcher by (Skyworth
                 9S52_Q4A, Android 6, issue #397; also what makes Dangbei's launcher selectable there).
                 Not verified to change the boot launcher yet. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME.CC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
