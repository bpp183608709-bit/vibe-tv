# 机器上 /etc/systemd/system/wrong-quiz.service 的原样副本，改这里之后要重新 scp + daemon-reload。
# 两个刻意的选择：ExecStart 只指向 deploy/bin/app（端口、证书、参数都在那个脚本里，单元被覆盖也不会
# 丢掉它们），以及 ReadWritePaths 必须含 /var/lib/tvault/wrong-quiz —— 保险库每次启动都要 chmod 那个
# 目录，ProtectSystem=strict 下不放行就报 read-only file system 直接起不来。

[Unit]
Description=错题系统 (wrong-quiz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wrongquiz
Group=tvault
WorkingDirectory=/opt/wrong-quiz

# 本系统专属保险库：仅含 wrong-quiz 一个项目，目录属主为本服务账号
Environment=TVAULT_DIR=/var/lib/tvault/wrong-quiz

# 主密码由 systemd 以 root 读取，投递到仅本服务可见的凭证目录
LoadCredential=pass.env:/etc/tvault/wrong-quiz-pass.env

# 实际启动命令：按需修改下面的路径与参数
ExecStart=/usr/local/bin/tvault-run.sh wrong-quiz /opt/wrong-quiz/bin/app

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 必须同时放行 vault 目录：TinyVault 每次启动都要 chmod 加固该目录并写审计日志，
# ProtectSystem=strict 下若不放行会报 "read-only file system" 而直接启动失败。
ReadWritePaths=/opt/wrong-quiz /var/lib/tvault/wrong-quiz
# 若应用需写日志/数据目录，在此追加，例如：
# ReadWritePaths=/var/log/wrong-quiz /var/lib/wrong-quiz

[Install]
WantedBy=multi-user.target
