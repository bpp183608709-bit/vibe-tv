# 部署参数。**这里没有密钥，也不许有。**
#
# DEEPSEEK_API_KEY 由 tvault-run.sh 在进程启动前注入环境，本文件不该知道它存在；
# 数据库没有密码，因为账号是 MySQL 的 auth_socket —— 内核已经在 socket 另一端验过 uid。
#
# 复制到 /opt/wrong-quiz/deploy.env，属主 wrongquiz:tvault，权限 0640。

# 生产库：unix socket + auth_socket，没有密码可写、可漏
QUIZ_DSN=mysql://wrongquiz@localhost/quiz?unix_socket=/run/mysqld/mysqld.sock

# ES256 票签名私钥。丢了这个文件，手上还没兑换的票全部作废；泄露了它，任何票都能伪造。
QUIZ_TICKET_KEY=/opt/wrong-quiz/secrets/ticket-signing-key.pem

# 家长页（公信证书端口）与电视（钉住自签 CA 的端口）。
# 443 需要 systemd 单元里的 CAP_NET_BIND_SERVICE（见 deploy/systemd/wrong-quiz.service）；
# 退回 8443 只改这一行 + 重启，不用动证书，也不用重新出 APK。
QUIZ_H5_PORT=443
QUIZ_TV_PORT=9443

# 家长页单独用一张公信证书（现在是 Let's Encrypt 的域名证书，由 cert-hook.sh 搬进 tls/）。
# 不写这两行就回落到 tls/server.pem，也就是手机要手点一次「继续访问」。电视那条永远用 server.pem。
# QUIZ_H5_CERT=/opt/wrong-quiz/tls/h5.pem
# QUIZ_H5_KEY=/opt/wrong-quiz/tls/h5.key

# 只监听 127.0.0.1 的明文端口，给本机 curl 与运维脚本用。按规范默认 8100，可被环境变量 PORT 覆盖。
PORT=8100

# 模型名做成配置，换模型是重启而不是改代码。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONCURRENCY=8
